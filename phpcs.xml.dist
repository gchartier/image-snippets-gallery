<?xml version="1.0"?>
<ruleset name="ImageSnippets Gallery">
	<description>WordPress coding standards for the ImageSnippets Gallery plugin.</description>

	<file>.</file>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Third-party library, vendored verbatim (MIT). Not held to WPCS. -->
	<exclude-pattern>*/devenv/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/><!-- show sniff codes and progress -->

	<!-- WordPress-Extra = Core (formatting) + best-practice and security sniffs. -->
	<rule ref="WordPress-Extra"/>

	<config name="minimum_wp_version" value="6.4"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="image-snippets-gallery"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="isgal"/>
				<element value="ISGAL"/>
			</property>
		</properties>
	</rule>

	<!-- includes/cli.php holds one WP-CLI command class; the class-*.php file
	     naming convention is not worth a rename here. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/includes/cli.php</exclude-pattern>
	</rule>
</ruleset>
