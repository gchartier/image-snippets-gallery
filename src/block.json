{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imagesnippets/gallery",
	"version": "0.7.0",
	"title": "ImageSnippets Gallery",
	"category": "media",
	"icon": "format-gallery",
	"description": "Responsive, server-rendered gallery of images from ImageSnippets, with embedded provenance metadata (JSON-LD).",
	"keywords": [
		"gallery",
		"imagesnippets",
		"rdf",
		"provenance",
		"sparql",
		"media"
	],
	"textdomain": "image-snippets-gallery",
	"supports": {
		"html": false,
		"interactivity": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true
	},
	"attributes": {
		"gallery": {
			"type": "string",
			"default": ""
		},
		"userId": {
			"type": "string",
			"default": ""
		},
		"endpoint": {
			"type": "string",
			"default": ""
		},
		"displayCaption": {
			"type": "boolean",
			"default": false
		},
		"captionPosition": {
			"type": "string",
			"default": "below"
		},
		"captionFields": {
			"type": "array",
			"default": [ "title" ]
		},
		"captionTags": {
			"type": "number",
			"default": 3
		},
		"onClick": {
			"type": "string",
			"default": "page"
		},
		"linkNewTab": {
			"type": "boolean",
			"default": true
		},
		"lightboxDetails": {
			"type": "boolean",
			"default": true
		},
		"dateFields": {
			"type": [ "array", "null" ]
		},
		"facets": {
			"type": "array",
			"default": []
		},
		"facetMax": {
			"type": "number",
			"default": 12
		},
		"hoverEffect": {
			"type": "string",
			"default": "none"
		},
		"captionBackground": {
			"type": "string"
		},
		"displayTitle": {
			"type": "boolean",
			"default": false
		},
		"titleLevel": {
			"type": "number",
			"default": 2
		},
		"layout": {
			"type": "string",
			"default": "grid"
		},
		"order": {
			"type": "string",
			"default": "desc"
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"limit": {
			"type": "number",
			"default": 40
		},
		"thumbSize": {
			"type": "string",
			"default": "medium"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"aspectRatio": {
			"type": "string",
			"default": "4-3"
		},
		"useFilename": {
			"type": "boolean",
			"default": false
		},
		"cacheTtl": {
			"type": [ "number", "null" ]
		},
		"jsonldProfile": {
			"type": "string",
			"default": "provenance"
		},
		"imageBorder": {
			"type": "object"
		},
		"imageRadius": {
			"type": [ "string", "object" ]
		},
		"imageShadow": {
			"type": "string"
		},
		"separateText": {
			"type": "boolean",
			"default": false
		},
		"titleColor": {
			"type": "string"
		},
		"titleSize": {
			"type": "string"
		},
		"captionColor": {
			"type": "string"
		},
		"captionSize": {
			"type": "string"
		}
	},
	"example": {
		"attributes": {
			"gallery": "mmgallery01",
			"displayCaption": true,
			"displayTitle": true,
			"limit": 6
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
